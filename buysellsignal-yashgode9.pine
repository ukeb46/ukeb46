//@version=6
//@author = yashgode9 [YASH NANDKUMAR GODE]

import yashgode9/signalLib_yashgode9/2 as signalLib
indicator('buysellsignal-yashgode9', 'buysellsignal-yashgode9', true, format.price, max_labels_count = 200, max_lines_count = 50)

// ==================== TIMEFRAME DETECTION ====================
is1sChart = timeframe.isseconds and timeframe.multiplier == 1
is5sChart = timeframe.isseconds and timeframe.multiplier <= 5
isSubMinute = timeframe.isseconds

// ==================== INPUTS ====================
// Otomatik parametre ayarları (1s grafikler için optimize edilmiş)
defaultDepth = is1sChart ? 8 : is5sChart ? 12 : isSubMinute ? 15 : 30
defaultDeviation = is1sChart ? 2 : is5sChart ? 3 : isSubMinute ? 4 : 5
defaultBackstep = is1sChart ? 2 : is5sChart ? 3 : isSubMinute ? 4 : 5

DEPTH_ENGINE = input.int(8, 'DEPTH_ENGINE (1s için optimize: 5-10)', minval = 1, step = 1, group = 'signalLib Config', tooltip = '1s grafikler için 5-10 arası önerilir')
DEVIATION_ENGINE = input.int(2, 'DEVIATION_ENGINE (1s için optimize: 2-3)', minval = 1, step = 1, group = 'signalLib Config', tooltip = '1s grafikler için 2-3 önerilir')
BACKSTEP_ENGINE = input.int(2, 'BACKSTEP_ENGINE (1s için optimize: 2-3)', minval = 2, step = 1, group = 'signalLib Config', tooltip = '1s grafikler için 2-3 önerilir')

labelTransparency = input.int(0, 'Labels Transparency', minval = 0, maxval = 100, group = 'Labels')
labelsize__0 = input.int(3, 'Label size', minval = 1, maxval = 5, group = 'Labels')
labelsize = labelsize__0 == 1 ? size.tiny : labelsize__0 == 2 ? size.small : labelsize__0 == 3 ? size.normal : labelsize__0 == 4 ? size.large : size.huge

buycolor = input.color(#03ff85, 'Buy-Color', group = 'Colors')
sellcolor = input.color(#fc0808, 'Sell-Color', group = 'Colors')
buycolor1 = #000000
sellcolor1 = #000000

enableBuyAlerts = input.bool(true, 'Enable Buy Alerts', group = 'Alerts')
enableSellAlerts = input.bool(true, 'Enable Sell Alerts', group = 'Alerts')

// ==================== FILTERS (1s için gürültü azaltma) ====================
useNoiseFilter = input.bool(true, 'Gürültü Filtresi (1s için önerilen)', group = 'Filters', tooltip = 'ATR bazlı minimum hareket filtresi - yanlış sinyalleri azaltır')
atrLength = input.int(14, 'ATR Uzunluğu', minval = 1, group = 'Filters')
atrMultiplier = input.float(0.3, 'ATR Çarpanı (1s için: 0.2-0.5)', minval = 0.1, step = 0.1, group = 'Filters', tooltip = 'Düşük değer = daha fazla sinyal, Yüksek değer = daha az ama kaliteli sinyal')
useVolumeFilter = input.bool(false, 'Volume Filtresi (opsiyonel)', group = 'Filters')
volumeMultiplier = input.float(1.2, 'Volume Çarpanı', minval = 0.5, step = 0.1, group = 'Filters')
consecutiveSignalBars = input.int(2, 'Ardışık Sinyal Önleme (bar)', minval = 1, group = 'Filters', tooltip = 'Aynı yönde çok hızlı sinyal üretmeyi engeller')

repaint = true
extend = false

// ==================== SIGNAL LIB ====================
[direction, zee1, zee2] = signalLib.signalLib(low, high, DEPTH_ENGINE, DEVIATION_ENGINE, BACKSTEP_ENGINE)

// ==================== VARIABLES ====================
var float lastPoint = na
var float field_1 = na
var float field_2 = na
var float field_3 = na
var line zeezee = na
var label point = na
var string nowPoint = ''

field_0 = zee1.price

// ==================== DIRECTION CHANGE LOGIC ====================
directionChanged = ta.change(direction) != 0
lastPoint := directionChanged ? field_1 : lastPoint
field_1 := directionChanged ? field_0 : field_1

// ==================== LABEL & LINE DRAWING ====================
if directionChanged
    zeezee := na
    point := na
    nowPoint := ''

    if repaint
        nowPoint := direction < 0 ? zee2.price < lastPoint ? 'Buy-point' : 'Buy-point' : zee2.price > lastPoint ? 'Sell-point' : 'Sell-point'

        labelColor = color.new(direction < 0 ? buycolor : sellcolor, labelTransparency)
        labelStyle = direction > 0 ? label.style_label_down : label.style_label_up
        textColor = color.new(direction > 0 ? buycolor1 : sellcolor1, labelTransparency)
        point := label.new(zee2, nowPoint, xloc.bar_time, yloc.price, labelColor, labelStyle, textColor, labelsize)

        if direction == direction[1]
            line.delete(zeezee[1])
            label.delete(point[1])
        else
            line.set_extend(zeezee[1], extend.none)
    else
        if direction != direction[1]
            field_2 := zee2.price
            field_3 := zee2.price
            nowPoint := direction[1] < 0 ? field_2[1] < lastPoint[1] ? 'Buy-point' : 'Buy-point' : field_3[1] > lastPoint[1] ? 'Sell-point' : 'Sell-point'

            labelColor = color.new(direction[1] < 0 ? buycolor : sellcolor, labelTransparency)
            labelStyle = direction[1] > 0 ? label.style_label_down : label.style_label_up
            textColor = color.new(direction[1] > 0 ? buycolor1 : sellcolor1, labelTransparency)
            point := label.new(zee2[1], nowPoint, xloc.bar_time, yloc.price, labelColor, labelStyle, textColor, labelsize)

// ==================== FILTER CALCULATIONS ====================
atr = ta.atr(atrLength)
minPriceMove = atr * atrMultiplier
avgVolume = ta.sma(volume, 20)

// Fiyat hareketi yeterli mi?
priceMoveSufficient = not useNoiseFilter or math.abs(close - open) >= minPriceMove

// Volume yeterli mi?
volumeSufficient = not useVolumeFilter or volume >= (avgVolume * volumeMultiplier)

// Ardışık sinyal kontrolü
var int lastBuyBar = -999
var int lastSellBar = -999
var int barCounter = 0
barCounter := barCounter + 1

// ==================== BUY/SELL SIGNALS ====================
buySignalRaw = directionChanged and direction < 0
sellSignalRaw = directionChanged and direction > 0

// Filtreleri uygula
buyAllowed = (barCounter - lastBuyBar) >= consecutiveSignalBars
sellAllowed = (barCounter - lastSellBar) >= consecutiveSignalBars

buySignal = buySignalRaw and priceMoveSufficient and volumeSufficient and buyAllowed
sellSignal = sellSignalRaw and priceMoveSufficient and volumeSufficient and sellAllowed

// Bar sayaçlarını güncelle
if buySignal
    lastBuyBar := barCounter
if sellSignal
    lastSellBar := barCounter

// ==================== ALERTS ====================
if buySignal and enableBuyAlerts
    alert("Buy signal generated!!!", alert.freq_once_per_bar_close)

if sellSignal and enableSellAlerts
    alert("Sell signal generated!!!", alert.freq_once_per_bar_close)

alertcondition(buySignal and enableBuyAlerts, "Buy Alert", "BUY SIGNAL - {{ticker}} @ {{close}}")
alertcondition(sellSignal and enableSellAlerts, "Sell Alert", "SELL SIGNAL - {{ticker}} @ {{close}}")

// ==================== PLOT SHAPES ====================
plotshape(buySignal, 'Buy', shape.triangleup, location.belowbar, buycolor, text = "BUY", size = size.small)
plotshape(sellSignal, 'Sell', shape.triangledown, location.abovebar, sellcolor, text = "SELL", size = size.small)

// ==================== DEBUG & INFO (Opsiyonel) ====================
showDebugInfo = input.bool(false, 'Debug Bilgilerini Göster', group = 'Debug')
if showDebugInfo
    var table debugTable = table.new(position.top_right, 2, 6, border_width = 1)
    if barstate.islast
        table.cell(debugTable, 0, 0, "Zaman Dilimi", text_color = color.white, bgcolor = color.blue)
        table.cell(debugTable, 1, 0, is1sChart ? "1 saniye" : isSubMinute ? str.tostring(timeframe.multiplier) + "s" : timeframe.period, text_color = color.white)
        table.cell(debugTable, 0, 1, "Depth", text_color = color.white, bgcolor = color.blue)
        table.cell(debugTable, 1, 1, str.tostring(DEPTH_ENGINE), text_color = color.white)
        table.cell(debugTable, 0, 2, "ATR", text_color = color.white, bgcolor = color.blue)
        table.cell(debugTable, 1, 2, str.tostring(math.round(atr, 2)), text_color = color.white)
        table.cell(debugTable, 0, 3, "Min Hareket", text_color = color.white, bgcolor = color.blue)
        table.cell(debugTable, 1, 3, str.tostring(math.round(minPriceMove, 2)), text_color = color.white)
        table.cell(debugTable, 0, 4, "Gürültü Filtresi", text_color = color.white, bgcolor = color.blue)
        table.cell(debugTable, 1, 4, useNoiseFilter ? "✓ Aktif" : "✗ Kapalı", text_color = useNoiseFilter ? color.green : color.red)
        table.cell(debugTable, 0, 5, "Volume Filtresi", text_color = color.white, bgcolor = color.blue)
        table.cell(debugTable, 1, 5, useVolumeFilter ? "✓ Aktif" : "✗ Kapalı", text_color = useVolumeFilter ? color.green : color.red)

// Filtrelenmiş sinyalleri göster (debug için)
showFilteredSignals = input.bool(false, 'Filtrelenmiş Sinyalleri Göster', group = 'Debug', tooltip = 'Filtreler tarafından engellenmiş sinyalleri gri ile gösterir')
if showFilteredSignals
    buyFiltered = buySignalRaw and not buySignal
    sellFiltered = sellSignalRaw and not sellSignal
    plotshape(buyFiltered, 'Filtered Buy', shape.xcross, location.belowbar, color.new(color.gray, 50), size = size.tiny)
    plotshape(sellFiltered, 'Filtered Sell', shape.xcross, location.abovebar, color.new(color.gray, 50), size = size.tiny)
